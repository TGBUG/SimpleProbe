[Unit]
Description=SimpleProbe server (接收上报 + 只读查询)
Documentation=https://github.com/TGBUG/SimpleProbe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- 运行身份 ----
#
# 安装脚本会把下面这行改成「安装目录的属主」。服务以目录主人的身份运行：
# 目录本来就是它的，所以配置可以保持 0600，也不用新建任何账户
# （agent↔server 只有单向上报，server 侧不存在下发指令的代码路径）。
#
# 手动部署的话：把 probe 换成一个已存在的非 root 用户，
# 并把安装目录 chown 给 ta，否则服务读不到配置、也写不了 data/。
User=probe

WorkingDirectory=/opt/simpleprobe

# ---- 全部文件都在安装目录里 ----
# 只有这个 systemd 单元没法挪，必须待在 /etc/systemd/system。
ExecStart=/opt/simpleprobe/bin/server -config /opt/simpleprobe/etc/nodes.yaml -web /opt/simpleprobe/web
# 不想让 server 托管静态文件就删掉 -web，交给反代或干脆不用面板。

Restart=on-failure
RestartSec=3

# 加机器不用重启：改完 etc/nodes.yaml 后 systemctl reload simple-probe-server
ExecReload=/bin/kill -HUP $MAINPID

# ---- 加固 ----
# ProtectSystem=strict 会把整个文件系统挂成只读，所以数据目录要显式放行。
ReadWritePaths=/opt/simpleprobe/data

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=

# ---- 下面两项收紧得更狠，也更容易在特殊环境里出问题 ----
# 若启动失败，先看 journalctl -u simple-probe-server，把这两行注释掉再试。
# Go 不做 JIT，禁用可写可执行内存是安全的。
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
