# 反向代理示例（nginx）。
#
# 重要：这不是必需的。服务端只是个 HTTP 端点，"listen" 想监听什么就监听什么。
# 用 Caddy / Traefik / HAProxy / 云厂商 LB 都行，也可以完全不用代理。
# 只有当你要「公网 + HTTPS + 隐藏后端端口」时才需要它。
#
# 服务端代码里没有任何代理相关的假设：它不读 X-Forwarded-For，
# 也不做基于客户端 IP 的限流（上报按节点限流，读接口靠 Cache-Control），
# 所以换成任何反代都不需要改配置或代码。

server {
    listen 443 ssl;
    http2 on;
    server_name probe.example.com;

    ssl_certificate     /etc/letsencrypt/live/probe.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/probe.example.com/privkey.pem;

    # 请求体上限与服务端的 8KB 校验保持一致，别让 nginx 成为唯一的限制。
    client_max_body_size 16k;

    # 前端静态文件可以直接由 nginx 托管（此时 server 不用加 -web）。
    root /opt/probe/web;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # API 全部转给后端。
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 只读查询接口自带 Cache-Control: public, max-age=15，
        # 这里不要额外加缓存，否则前端会看到更旧的数据。
        proxy_buffering off;
    }

    # 如果只想暴露读接口、不接收上报（上报走内网直连或另一台机器），
    # 把下面这段放开，顺手把上报端点挡在公网之外：
    #
    # location = /api/v1/report {
    #     return 403;
    # }
}
