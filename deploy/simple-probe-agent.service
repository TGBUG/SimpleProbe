[Unit]
Description=SimpleProbe agent (只读采集本机指标并上报)
Documentation=https://github.com/TGBUG/SimpleProbe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- 运行身份 ----
#
# 安装脚本会把下面这行改成「安装目录的属主」，不新建任何账户。
# agent 只读 /proc 与 statvfs、纯出站、不接受任何入站连接。
#
# 手动部署的话：把 probe 换成一个已存在的非 root 用户，
# 并把安装目录 chown 给 ta，否则服务读不到配置。
User=probe

WorkingDirectory=/opt/simpleprobe

# ---- 全部文件都在安装目录里 ----
# 只有这个 systemd 单元没法挪，必须待在 /etc/systemd/system。
ExecStart=/opt/simpleprobe/bin/agent -config /opt/simpleprobe/etc/agent.yaml

# 纯出站：不需要开任何入站端口，也不需要任何 capability。
Restart=always
RestartSec=5

# ---- 加固 ----
# agent 全程只需读取，所以整盘只读是安全的（ProtectSystem=strict 把 / 与
# /usr 挂成只读，只有 /dev /proc /sys 例外——而 /proc 正是它要读的）。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=

# ---- 下面两项收紧得更狠，也更容易在特殊环境里出问题 ----
# 若启动失败，先看 journalctl -u simple-probe-agent，把这两行注释掉再试。
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
