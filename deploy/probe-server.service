[Unit]
Description=SimpleProbe server (接收上报 + 只读查询)
Documentation=https://github.com/TGBUG/SimpleProbe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- 运行身份：不创建任何账户 ----
#
# agent 与 server 之间只有「agent 单向上报」这一条链路，server 侧不存在任何
# 向 agent 下发指令的代码路径；为一个只读进程单独建系统账户收益有限。
# DynamicUser 让 systemd 在启动时临时分配 uid，既省掉 useradd，又仍然不是
# root——所以账户这一步省了，非 root 这条仍然保住了。
DynamicUser=yes

# 数据库目录由 systemd 创建并 chown 给那个临时 uid，所以配置文件里的
# db 路径写 /var/lib/probe/probe.db 即可，不需要任何 chown 步骤。
StateDirectory=probe
StateDirectoryMode=0700

WorkingDirectory=/opt/probe

# nodes.yaml 里是明文 token，默认 0644（见 README 的说明与更严的替代方案）。
# 配置走文件路径而不是 LoadCredential，是为了让 SIGHUP 热加载真的有效——
# credential 是启动时的快照，reload 读到的会是旧内容。
ExecStart=/opt/probe/bin/server -config /etc/probe/nodes.yaml -web /opt/probe/web
# 不想让 server 托管静态文件就删掉 -web，交给反代或干脆不用面板。

Restart=on-failure
RestartSec=3

# 加机器不用重启：改完 /etc/probe/nodes.yaml 后 systemctl reload probe-server
ExecReload=/bin/kill -HUP $MAINPID

# ---- 加固 ----
# 这些项只收紧权限、不改变功能，正常情况下不会导致启动失败。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=

# ---- 下面两项收紧得更狠，也更容易在特殊环境里出问题 ----
# 若启动失败，先看 journalctl -u probe-server，把这两行注释掉再试。
# Go 不做 JIT，禁用可写可执行内存是安全的。
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
